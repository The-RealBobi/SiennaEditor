<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SiennaEditor" x:Class="SiennaEditor.EditorWindow"
        Icon="/Assets/app.png" Title="Sienna Editor" Width="1180" Height="740" MinWidth="860" MinHeight="540"
        Background="{DynamicResource CanvasBrush}" Foreground="#E3E8ED" FontSize="13"
        FontFamily="Segoe UI,Helvetica Neue,Arial" RequestedThemeVariant="Dark"
        DragDrop.AllowDrop="True" DragDrop.DragOver="FileDragOver" DragDrop.Drop="FileDrop">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#191D22</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBrush">#242A32</SolidColorBrush>
    <SolidColorBrush x:Key="ActionBrush">#35434C</SolidColorBrush>
    <SolidColorBrush x:Key="ValueBrush">#20262D</SolidColorBrush>
    <SolidColorBrush x:Key="SelectedBrush">#2C5552</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#39414B</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#A4AFBB</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="3" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Background" Value="{DynamicResource ValueBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="3" /><Setter Property="Background" Value="{DynamicResource ValueBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="25" /><Setter Property="Padding" Value="5,2" /><Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></Style>
    <Style Selector="ListBoxItem.drop-sibling"><Setter Property="BorderBrush" Value="#69B8AE" /><Setter Property="BorderThickness" Value="0,0,0,2" /></Style>
    <Style Selector="ListBoxItem.drop-child"><Setter Property="BorderBrush" Value="#69B8AE" /><Setter Property="BorderThickness" Value="2,0,0,2" /></Style>
    <Style Selector="MenuItem"><Setter Property="Padding" Value="10,3" /></Style>
  </Window.Styles>
  <Grid x:Name="Workspace" RowDefinitions="25,46,34,*,24">
    <Menu Background="{DynamicResource PanelBrush}">
      <MenuItem Header="File">
        <MenuItem Header="New CFGBIN" Click="NewClicked" InputGesture="Ctrl+N" />
        <MenuItem Header="Open…" Click="OpenClicked" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="Save" Click="SaveClicked" InputGesture="Ctrl+S" />
        <MenuItem Header="Save as…" Click="SaveBinClicked" />
        <MenuItem Header="Save all" Click="SaveAllClicked" />
        <MenuItem Header="Export CFG…" Click="ExportCfgClicked" />
        <Separator />
        <MenuItem Header="Close tab" Click="CloseActiveClicked" InputGesture="Ctrl+W" />
        <MenuItem Header="Exit" Click="ExitClicked" />
      </MenuItem>
      <MenuItem Header="Settings" Click="SettingsClicked" />
      <MenuItem Header="Tools">
        <MenuItem Header="Export batch…" Click="ExportBatchClicked" InputGesture="Ctrl+Shift+E" />
        <MenuItem Header="ConflictMerge" Click="ConflictMergeClicked" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="12,7">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <Button Content="Open…" Click="OpenClicked" Margin="0,0,8,0" AutomationProperties.AutomationId="open-file" />
        <Button Grid.Column="1" Content="Save" Click="SaveClicked" Margin="0,0,6,0" Background="{DynamicResource SelectedBrush}" AutomationProperties.AutomationId="save-file" ToolTip.Tip="Save current file (Ctrl/Cmd+S)" />
      </Grid>
    </Border>
    <ListBox Grid.Row="2" x:Name="Tabs" Margin="12,3,12,0" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
             SelectionChanged="TabChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="document-tabs">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="Padding" Value="9,2" /><Setter Property="CornerRadius" Value="4,4,0,0" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:EditorSession">
          <StackPanel Orientation="Horizontal" Spacing="9" ToolTip.Tip="{Binding SourcePath}">
            <TextBlock Text="{Binding Title}" MaxWidth="290" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Content="×" Width="20" MinHeight="22" Padding="0" Background="Transparent" Click="CloseTabClicked" AutomationProperties.Name="Close file" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" ColumnDefinitions="320,9,*" Margin="12,10,12,0">
      <Grid RowDefinitions="24,36,0,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="1" x:Name="RecordsCount" Foreground="{DynamicResource MutedBrush}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,36" Margin="0,0,0,7">
          <TextBox x:Name="Search" PlaceholderText="Search entries and values" TextChanged="SearchChanged" KeyDown="SearchKeyDown" AutomationProperties.AutomationId="search-records" />
          <Button Grid.Column="1" x:Name="RootAdd" HorizontalAlignment="Stretch" Content="+" FontSize="20" Padding="0" Margin="5,0,0,0" Click="AddRootClicked" ToolTip.Tip="Add root entry" AutomationProperties.AutomationId="add-root" AutomationProperties.Name="Add root entry" />
        </Grid>
        <ListBox Grid.Row="3" x:Name="Records" Background="{DynamicResource ValueBrush}" BorderThickness="0"
                 SelectionChanged="RecordChanged" KeyDown="TreeKeyDown" PointerPressed="RecordPointerPressed" AutomationProperties.AutomationId="records">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="AddContext" Header="Add entry" AutomationProperties.AutomationId="add-entry-context">
                <MenuItem Header="As child" Click="AddChildClicked" AutomationProperties.AutomationId="add-child-context" />
              </MenuItem>
              <MenuItem Header="Duplicate" Click="DuplicateClicked" />
              <MenuItem Header="Remove" Click="DeleteClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:RecordBranch">
              <Grid ColumnDefinitions="17,*" Margin="{Binding Indent}" MinHeight="23" ToolTip.Tip="{Binding Heading}">
                <Button Content="{Binding Toggle}" IsVisible="{Binding HasChildren}" Click="ToggleClicked" Width="17" MinHeight="23"
                        Padding="0" Background="Transparent" AutomationProperties.Name="{Binding ToggleName}" />
                <TextBlock Grid.Column="1" Text="{Binding Heading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
      <Grid Grid.Column="2" RowDefinitions="31,26,*" Margin="7,0,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Fields" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="AddValue" Content="Add value" Click="AddValueClicked" AutomationProperties.AutomationId="add-value" />
        </Grid>
        <Grid Grid.Row="1" x:Name="FieldHeader" ColumnDefinitions="100,220,*" Margin="0,5,17,0">
          <TextBlock x:Name="TypeHeader" Text="Type" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource MutedBrush}" Margin="6,0" />
          <TextBlock Grid.Column="2" Text="Value" Foreground="{DynamicResource MutedBrush}" Margin="6,0" />
        </Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
          <ItemsControl x:Name="Fields" AutomationProperties.AutomationId="fields">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FieldEdit">
                <Grid Margin="0,0,0,5" MinHeight="29">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TypeWidth}" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.ContextMenu><ContextMenu><MenuItem Header="Restore value" Click="RestoreFieldClicked" /><MenuItem Header="Toggle null string" IsEnabled="{Binding IsString}" Click="NullFieldClicked" /><MenuItem Header="Remove value" IsEnabled="{Binding CanRemove}" Click="RemoveValueClicked" /></ContextMenu></Grid.ContextMenu>
                  <ComboBox Margin="0,0,6,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind,Mode=TwoWay}" IsVisible="{Binding CanChangeKind}" AutomationProperties.Name="Value type" />
                  <TextBox Grid.Column="1" Margin="6,0" Text="{Binding Label,Mode=TwoWay}" IsEnabled="{Binding CanEditLabel}" LostFocus="FieldNameLostFocus" ToolTip.Tip="Field names are saved automatically" AutomationProperties.Name="Field name" />
                  <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Text,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AcceptsReturn="{Binding IsString}"
                           MaxHeight="90" TextWrapping="NoWrap" FontFamily="SF Mono,Cascadia Mono,Consolas,monospace" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="Status" Text="Open a file to begin" Margin="12,4,12,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="status" />
  </Grid>
</Window>
