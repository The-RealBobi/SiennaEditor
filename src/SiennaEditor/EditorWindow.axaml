<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SiennaEditor" x:Class="SiennaEditor.EditorWindow"
        Title="Sienna Editor" Width="1240" Height="820" MinWidth="900" MinHeight="600"
        Background="#211C19" Foreground="#EEE5DD" RequestedThemeVariant="Dark">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <Style Selector="TextBox"><Setter Property="FontFamily" Value="Menlo,Consolas,monospace" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="Workspace" RowDefinitions="Auto,Auto,*" Margin="18">
      <WrapPanel Grid.Row="0" Margin="0,0,0,12">
        <Button Content="Open…" Click="OpenClicked" AutomationProperties.AutomationId="open-file" />
        <Button Content="Load Structure…" Click="StructureClicked" AutomationProperties.AutomationId="load-structure" />
        <ComboBox x:Name="Profiles" MinWidth="165" Margin="0,0,12,0" SelectionChanged="ProfileChanged" AutomationProperties.AutomationId="profile" />
        <Button Content="Save BIN as…" Click="SaveBinClicked" AutomationProperties.AutomationId="save-bin" />
        <Button Content="Export CFG…" Click="ExportCfgClicked" AutomationProperties.AutomationId="export-cfg" />
        <Button Content="Schema…" Click="SchemaClicked" AutomationProperties.AutomationId="inspect-schema" />
      </WrapPanel>
      <Border Grid.Row="1" Background="#302722" Padding="12" Margin="0,0,0,12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="FileTitle" Text="Open a BIN or CFG file to begin" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="FileInfo" Text="The bundled Structure is ready. You can load your own catalog." Foreground="#C5AEA0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" ColumnDefinitions="350,8,*">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <ComboBox x:Name="Types" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.AutomationId="record-type" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8">
            <TextBox x:Name="Search" PlaceholderText="Find a record or value" KeyDown="SearchKeyDown" AutomationProperties.AutomationId="search-records" />
            <Button Grid.Column="1" Content="Find" Click="FindClicked" Margin="6,0,0,0" />
          </Grid>
          <ListBox Grid.Row="2" x:Name="Records" SelectionChanged="RecordChanged" AutomationProperties.AutomationId="records">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:RecordChoice">
                <StackPanel Margin="2,4" Spacing="3">
                  <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="#C5AEA0" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <Button x:Name="Previous" Content="←" Click="PreviousClicked" AutomationProperties.AutomationId="previous-page" />
            <TextBlock Grid.Column="1" x:Name="PageInfo" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="2" x:Name="Next" Content="→" Click="NextClicked" Margin="0" AutomationProperties.AutomationId="next-page" />
          </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#514137" />
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="14,0,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Apply row" Click="ApplyClicked" AutomationProperties.AutomationId="apply-row" />
            <Button Content="Revert row" Click="RevertClicked" AutomationProperties.AutomationId="revert-row" />
            <Button Content="Duplicate" Click="DuplicateClicked" AutomationProperties.AutomationId="duplicate-row" />
            <Button Content="Delete" Click="DeleteClicked" AutomationProperties.AutomationId="delete-row" />
          </StackPanel>
          <TextBlock Grid.Row="1" x:Name="RowInfo" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#C5AEA0"
                     Text="Fields keep their native order. Edits apply when you select another record." />
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Fields" AutomationProperties.AutomationId="fields">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:FieldEdit">
                  <Border BorderBrush="#514137" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="230,*,Auto">
                      <StackPanel Margin="0,0,10,0" Spacing="3">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#C5AEA0" />
                      </StackPanel>
                      <TextBox Grid.Column="1" Text="{Binding Text,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                               AcceptsReturn="{Binding IsString}" TextWrapping="Wrap" MaxHeight="180" MinWidth="120" />
                      <CheckBox Grid.Column="2" Margin="8,0,0,0" Content="null" IsVisible="{Binding IsString}" IsChecked="{Binding IsNull,Mode=TwoWay}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#302722" Padding="18,10">
      <TextBlock x:Name="Status" Text="Ready · decimal or 0x hexadecimal · booleans: true/false · ranges: start, count" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
